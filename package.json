{
  "name": "the-pub",
  "version": "0.1.0",
  "description": "An IDE-fashioned story planning and editing tool",
  "main": "./out/main/index.js",
  "author": "The Pub",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:packaged": "playwright test -c playwright.packaged.config.ts",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "basic-ftp": "^6.2.0",
    "chokidar": "^4.0.3",
    "citeproc-plus": "^2.0.4",
    "docx": "^9.7.1",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@playwright/test": "^1.56.0",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-character-count": "^3.30.1",
    "@tiptap/extension-highlight": "^3.30.1",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/extension-subscript": "^3.30.1",
    "@tiptap/extension-superscript": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extension-text-style": "^3.30.1",
    "@tiptap/extension-typography": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@tiptap/suggestion": "^3.30.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.0.4",
    "dockview-react": "^8.1.0",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "ftp-srv": "^4.6.3",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "ulid": "^3.0.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  }
