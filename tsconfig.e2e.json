{
  "include": ["e2e/**/*", "playwright.config.ts", "src/shared/**/*", "src/preload/index.d.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Specs run in Node but their `page.evaluate` callbacks execute in the
    // renderer, so both sets of globals are in scope here.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"] }
  }
}
